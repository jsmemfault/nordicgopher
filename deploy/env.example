# Install to /etc/nordicgopher/env  (chmod 640, owned root:nordicgopher)

# The hostname clients will use. This is embedded in EVERY menu line, so a
# wrong value here breaks every link for remote users while still looking
# fine locally. It is the single most important setting in this file.
PUBLIC_HOST=nrf.jonsharp.net

# Advertised and bound port. 7070 keeps out of Motsognir's way on port 70.
# Every link you share must carry it: gopher://nrf.jonsharp.net:7070/
PORT=7070

# Bind to the jonsharp.net address specifically, so port 7070 stays free on
# the frstcomputer.com address. Use 0.0.0.0 to listen on all interfaces.
BIND_ADDRESS=127.0.0.1

# Published in caps.txt for gopher directories and for anyone who needs to
# report a problem with the mirror.
ADMIN_CONTACT=jon@jonsharp.net

# Optional. Only the repository ingest needs it: unauthenticated GitHub
# allows 60 requests/hour and each repository costs two, so without a token
# use -max-repos to stay inside the budget. The documentation ingest spends
# exactly one API request regardless.
#GITHUB_TOKEN=
